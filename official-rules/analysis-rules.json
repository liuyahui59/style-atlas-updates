{
  "schemaVersion": "style-atlas-rules-v3",
  "rules": [
    {
      "id": "general",
      "name": "通用视觉研究",
      "description": "从构图、层级、字体、色彩、图像与设计判断等维度记录有图片证据的视觉特征。",
      "version": "1.0.0",
      "kind": "general",
      "contract": {
        "version": "2",
        "kind": "general",
        "requiredModules": ["visualCore", "rationale"],
        "optionalModules": ["typography", "color", "imagery"],
        "hiddenModules": [],
        "displayOrder": ["visualCore", "rationale", "typography", "color", "imagery"],
        "moduleDefinitions": {
          "visualCore": {
            "label": "视觉结构",
            "fields": {
              "composition": { "label": "构图", "type": "string", "maxLength": 5000 },
              "grid": { "label": "网格", "type": "string", "maxLength": 5000 },
              "hierarchy": { "label": "信息层级", "type": "string", "maxLength": 5000 },
              "density": { "label": "信息密度", "type": "string", "maxLength": 500 },
              "whitespace": { "label": "留白", "type": "string", "maxLength": 5000 },
              "rhythm": { "label": "视觉节奏", "type": "string", "maxLength": 5000 }
            }
          },
          "rationale": {
            "label": "判断与建议",
            "fields": {
              "whyItWorks": { "label": "为何有效", "type": "array", "maxItems": 24 },
              "recommendations": { "label": "实现建议", "type": "array", "maxItems": 24 },
              "avoid": { "label": "避免事项", "type": "array", "maxItems": 24 }
            }
          },
          "typography": {
            "label": "字体与排版",
            "fields": {
              "category": { "label": "字体类别", "type": "string", "maxLength": 500 },
              "scale": { "label": "字号层级", "type": "string", "maxLength": 5000 },
              "weight": { "label": "字重", "type": "string", "maxLength": 5000 },
              "tracking": { "label": "字距", "type": "string", "maxLength": 5000 },
              "case": { "label": "大小写", "type": "string", "maxLength": 5000 },
              "notes": { "label": "排版说明", "type": "string", "maxLength": 5000 }
            }
          },
          "color": {
            "label": "色彩系统",
            "fields": {
              "mode": { "label": "明暗模式", "type": "string", "maxLength": 500 },
              "temperature": { "label": "色温", "type": "string", "maxLength": 500 },
              "saturation": { "label": "饱和度", "type": "string", "maxLength": 500 },
              "contrast": { "label": "对比关系", "type": "string", "maxLength": 5000 },
              "palette": { "label": "色板", "type": "palette", "maxItems": 8 },
              "notes": { "label": "用色规则", "type": "string", "maxLength": 5000 }
            }
          },
          "imagery": {
            "label": "图像语言",
            "fields": {
              "types": { "label": "图像类型", "type": "array", "maxItems": 24 },
              "treatment": { "label": "处理方式", "type": "string", "maxLength": 5000 },
              "cropping": { "label": "裁切方式", "type": "string", "maxLength": 5000 },
              "notes": { "label": "图像说明", "type": "string", "maxLength": 5000 }
            }
          }
        },
        "promptKinds": ["imageGeneration", "negative"],
        "promptDefinitions": {
          "imageGeneration": { "label": "视觉提示词", "maxLength": 5000 },
          "uiImplementation": { "label": "UI 实现说明", "maxLength": 5000 },
          "designTokens": { "label": "设计令牌", "maxLength": 5000 },
          "negative": { "label": "负面条件", "maxLength": 5000 }
        }
      },
      "prompt": "按通用视觉研究方式分析。各分析维度保持均衡，只记录能够从图片像素直接支持的设计事实；证据不足的字段省略，模块整体不可观察时标记对应状态。",
      "sha256": "cb082c6e31d5f8302d851b37fe3ae9a6a1221c19c9becad891839318ee34a715"
    }
  ]
}
